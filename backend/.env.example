# 服务器配置
PORT=3000
NODE_ENV=development
DB_TYPE=oracle

# JWT 配置
JWT_SECRET=your-super-secret-key-change-this-in-production
JWT_EXPIRES_IN=7d

# Oracle 数据库配置
ORACLE_HOST=localhost
ORACLE_PORT=1521
ORACLE_SERVICE_NAME=ORCL
ORACLE_USER=your_db_user
ORACLE_PASSWORD=your_db_password
ORACLE_POOL_MIN=1
ORACLE_POOL_MAX=3
ORACLE_POOL_INCREMENT=1

# 达梦数据库配置（DB_TYPE=dm 时使用）
DM_HOST=localhost
DM_PORT=5236
DM_USER=ONEFLOW
DM_PASSWORD=your_dm_password
DM_SCHEMA=ONEFLOW
DM_POOL_MIN=1
DM_POOL_MAX=50
DM_POOL_INCREMENT=5
DM_CONNECT_TIMEOUT_MS=5000
DM_SOCKET_TIMEOUT_MS=8000
DM_SESSION_TIMEOUT_SEC=8
DM_QUEUE_MAX=500
DM_QUEUE_TIMEOUT_MS=8000
LOGIN_TIMEOUT_MS=8000

# AI 服务配置
AI_BASE_URL=http://10.46.250.242:11434
AI_MODEL=qwen3.5

# 邮件配置（SMTP）
SMTP_HOST=smtp.cmcc.cn
SMTP_PORT=465
SMTP_USER=noreply@cmcc.cn
SMTP_PASSWORD=your_smtp_password
SMTP_FROM=noreply@cmcc.cn

# 文件上传配置
UPLOAD_MAX_SIZE=10485760
UPLOAD_DIR=./uploads

# 日志配置
LOG_LEVEL=info
LOG_DIR=./logs

# 安全配置
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=500
STRICT_RATE_LIMIT_WINDOW_MS=900000
STRICT_RATE_LIMIT_MAX_REQUESTS=100
BCRYPT_ROUNDS=10

# 生产环境请修改默认值
# JWT_SECRET 应使用强随机字符串
# 建议定期更换
